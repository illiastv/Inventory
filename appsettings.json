{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=inventory_auth.db",
    "Postgres": "Host=localhost;Port=5432;Database=inventory_auth;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "InventoryLab3",
    "Audience": "InventoryLab3.Client",
    "ExpiresMinutes": 30
  },
  "Cors": {
    "Origins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "Seed": {
    "AdminEmail": "admin@example.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
